---
import '../styles/global.css';
import restaurar from '../lib/restaurar.inline.js?raw';
import regular from '../../assets/fuentes/GoogleSans-Regular.woff2?url';
import negrita from '../../assets/fuentes/GoogleSans-Bold.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de la imagen para compartir (Open Graph), relativa al sitio. */
  imagen?: string;
  bodyClass?: string;
}
const { titulo, descripcion, imagen = '/og.jpg', bodyClass = '' } = Astro.props;
const canonica = new URL('/', Astro.site ?? Astro.url).href;
const urlImagen = new URL(imagen, canonica).href;
---

<!doctype html>
<html lang="es" data-uso="presentacion">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href="/icono-claro.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/icono-oscuro.svg" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:site_name" content="Tarija Tech Week 2026 · GDG Santa Cruz" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portada de la presentación: IA aplicada al desarrollo de software, el proceso de desarrollo en la era agéntica" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagen} />

    <link rel="preload" href={regular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={negrita} as="font" type="font/woff2" crossorigin />

    <!-- Restaura tema y modo antes del primer pintado. -->
    <script is:inline set:html={restaurar}></script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
