---
/**
 * Video de atmósfera: silenciado, en bucle, `playsinline`, con póster estático.
 * Se carga solo cuando hace falta (preload="none") y src/cliente/video.ts lo
 * pausa con prefers-reduced-motion, con ahorro de datos y fuera de pantalla.
 * Los GIF originales (assets/agentes/) no se publican: ver ADR-009.
 */
interface Props {
  nombre: 'agentes1' | 'agentes2';
  clase?: string;
  ancho?: number;
  alto?: number;
}
const { nombre, clase = '', ancho = 640, alto = 360 } = Astro.props;
---

<video
  class:list={['video-fondo', clase]}
  data-video-fondo
  muted
  loop
  playsinline
  preload="none"
  disablepictureinpicture
  disableRemotePlayback
  aria-hidden="true"
  tabindex="-1"
  width={ancho}
  height={alto}
  poster={`/media/${nombre}-poster.webp`}
>
  <source src={`/media/${nombre}.webm`} type="video/webm" />
  <source src={`/media/${nombre}.mp4`} type="video/mp4" />
</video>
