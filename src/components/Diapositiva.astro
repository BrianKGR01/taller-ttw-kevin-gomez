---
/**
 * Marco común de una diapositiva. Cada `tipo` del frontmatter se dibuja con su
 * componente de src/components/tipos/. Agregar un tipo = un componente, una
 * hoja en src/styles/tipos/ y una línea en este mapa (y en content.config.ts).
 */
import type { ItemDiapo } from '../lib/deck';
import Portada from './tipos/Portada.astro';
import Perfil from './tipos/Perfil.astro';
import Apertura from './tipos/Apertura.astro';
import Lista from './tipos/Lista.astro';
import Tabla from './tipos/Tabla.astro';
import Prompt from './tipos/Prompt.astro';
import Remate from './tipos/Remate.astro';
import CicloSlide from './tipos/CicloSlide.astro';
import Cita from './tipos/Cita.astro';
import Libros from './tipos/Libros.astro';
import CitaX from './tipos/CitaX.astro';
import Documento from './tipos/Documento.astro';
import Hitos from './tipos/Hitos.astro';
import Carpetas from './tipos/Carpetas.astro';
import CI from './tipos/CI.astro';
import Ejecucion from './tipos/Ejecucion.astro';
import Tarjetas from './tipos/Tarjetas.astro';
import Cierre from './tipos/Cierre.astro';
import Texto from './tipos/Texto.astro';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d, etiquetaBloque } = Astro.props;

const TIPOS = {
  portada: Portada,
  perfil: Perfil,
  apertura: Apertura,
  lista: Lista,
  pasos: Lista,
  tabla: Tabla,
  prompt: Prompt,
  remate: Remate,
  ciclo: CicloSlide,
  cita: Cita,
  libros: Libros,
  'cita-x': CitaX,
  documento: Documento,
  hitos: Hitos,
  carpetas: Carpetas,
  ci: CI,
  ejecucion: Ejecucion,
  tarjetas: Tarjetas,
  cierre: Cierre,
  texto: Texto,
} as const;
const Tipo = TIPOS[d.tipo as keyof typeof TIPOS] ?? Texto;
---

<article
  class={`diap diap--${d.tipo}`}
  id={`d-${d.id.replace('.', '-')}`}
  data-id={d.id}
  data-bloque={d.bloque}
  data-n={d.n}
  data-pasos={d.pasos}
  data-tipo={d.tipo}
  data-fase={d.fase || undefined}
  aria-roledescription="diapositiva"
  aria-label={`Diapositiva ${d.id}${d.titulo ? ': ' + d.titulo : ''}`}
>
  <div class="diap__cuerpo">
    <Tipo d={d} etiquetaBloque={etiquetaBloque} />

    {d.sinDev && (
      <aside class="sin-dev ent" style="--i:8">
        <strong>Si no eres dev:</strong> {d.sinDev}
      </aside>
    )}

    {d.htmlLectura && <div class="lectura-extra" set:html={d.htmlLectura} />}
  </div>
  <span class="diap__id" aria-hidden="true">{d.id}</span>
</article>
