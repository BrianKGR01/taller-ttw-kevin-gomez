---
/**
 * Diapositiva de tarjetas de enlace. El cuerpo Markdown (con o sin revelado
 * por pasos) va a un lado y las tarjetas de `datos.enlaces` al otro; sin
 * cuerpo, las tarjetas ocupan el ancho. Los textos viven en el .md.
 */
import type { ItemDiapo } from '../../lib/deck';
import TarjetaEnlace from '../TarjetaEnlace.astro';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d } = Astro.props;
const urls: string[] = Array.isArray(d.datos.enlaces) ? d.datos.enlaces : [];
const conTexto = d.html.trim().length > 0;
---

<div class:list={['tarjetas', conTexto ? 'tarjetas--con-texto' : 'tarjetas--solas']}>
  <header class="cabeza tarjetas__cabeza">
    {d.etiqueta && <p class="etiqueta ent" style="--i:0">{d.etiqueta}</p>}
    <h3 class="titulo ent" style="--i:1">{d.titulo}</h3>
    {d.subtitulo && <p class="subtitulo ent" style="--i:2">{d.subtitulo}</p>}
  </header>
  {conTexto && <div class="tarjetas__texto lista__items" set:html={d.html} />}
  <ul class="tarjetas__enlaces">
    {
      urls.map((url, i) => (
        <li class="tarjetas__item ent" style={`--i:${3 + i}`}>
          <TarjetaEnlace url={url} disposicion={conTexto ? 'horizontal' : 'vertical'} sizes={conTexto ? '(max-width: 820px) 94vw, 36vw' : '(max-width: 820px) 94vw, 44vw'} />
        </li>
      ))
    }
  </ul>
</div>
