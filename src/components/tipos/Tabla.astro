---
import type { ItemDiapo } from '../../lib/deck';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d } = Astro.props;
const tabla = d.tabla ?? { cols: [], filas: [] };
---

<div class="tabla">
  <header class="cabeza">
    {d.etiqueta && <p class="etiqueta ent" style="--i:0">{d.etiqueta}</p>}
    <h3 class="titulo ent" style="--i:1">{d.titulo}</h3>
  </header>
  <div class={`tabla__cols tabla__cols--${tabla.cols.length}`} style={`--filas:${tabla.filas.length}`} role="group" aria-label={d.titulo}>
    {tabla.cols.map((c, ci) => (
      <section class="tabla__col" data-lado={ci === 0 ? 'izq' : ci === tabla.cols.length - 1 ? 'der' : 'centro'} style={`--col:${ci}`}>
        <h4 class="tabla__cab" set:html={c} />
        <ul class="tabla__filas">
          {tabla.filas.map((f, fi) => (
            <li class="tabla__fila" style={`--fila:${fi}`} set:html={f[ci]} />
          ))}
        </ul>
      </section>
    ))}
  </div>
  {tabla.cols.length > 2 && (
    <ul class="tabla__tarjetas" aria-label={d.titulo}>
      {tabla.filas.map((f) => (
        <li class="tabla__tarjeta">
          <dl>
            {tabla.cols.map((c, ci) => (
              <div class="tabla__par">
                <dt set:html={c} />
                <dd set:html={f[ci]} />
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
  )}
</div>
