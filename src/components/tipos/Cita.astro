---
import type { ItemDiapo } from '../../lib/deck';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d } = Astro.props;
const terminal: string | undefined = d.datos.prompt;
---

<div class:list={['cita', { 'cita--terminal': Boolean(terminal) }]}>
  <header class="cabeza">
    {d.etiqueta && <p class="etiqueta ent" style="--i:0">{d.etiqueta}</p>}
    {d.titulo && <h3 class="titulo ent" style="--i:1">{d.titulo}</h3>}
  </header>
  {terminal && (
    <p class="cita__terminal ent" style="--i:2" data-teclear-linea>
      <span class="prompt-signo" aria-hidden="true">&gt;</span>
      <span data-teclear-texto>{terminal}</span>
    </p>
  )}
  <div class="cita__cuerpo ent" style="--i:3" set:html={d.html} />
</div>
