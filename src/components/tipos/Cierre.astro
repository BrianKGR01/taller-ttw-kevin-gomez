---
/**
 * Cierre ("Llévatelo"): QR grande a la propia presentación, contacto y
 * comunidad, con la foto del expositor muy tratada de fondo.
 *
 * - El QR se genera en el build con la URL de producción (`site` de
 *   astro.config.mjs) como SVG en línea; los colores son tokens (ver
 *   src/styles/tipos/cierre.css y src/lib/qr.ts).
 * - El contacto se lee en el build de assets/contacto.md (src/lib/contacto.ts).
 *   Si falta el archivo o un dato, se muestra un espacio marcado y discreto.
 * - Los textos del taller viven en el .md (cuerpo y `datos`).
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import charla from '../../assets/personas/charla.webp';
import type { ItemDiapo } from '../../lib/deck';
import { parsearContacto, REDES, type RedId } from '../../lib/contacto';
import { svgQR } from '../../lib/qr';
import CopiarBoton from '../CopiarBoton.astro';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d } = Astro.props;

const urlSitio = new URL('/', Astro.site ?? 'http://localhost:4321').href;
const textoUrl = urlSitio.replace(/^https?:\/\//, '').replace(/\/$/, '');
const qr = svgQR(urlSitio, { etiqueta: `Código QR que abre esta presentación: ${textoUrl}` });

let archivo: string | null = null;
try {
  archivo = readFileSync(join(process.cwd(), 'assets', 'contacto.md'), 'utf8');
} catch {
  archivo = null;
}
const contacto = parsearContacto(archivo);

const NOMBRES: Record<RedId, string> = { instagram: 'Instagram', whatsapp: 'WhatsApp', linkedin: 'LinkedIn' };
// Iconos genéricos dibujados aquí (cámara, burbuja, maletín): no son los logos de las redes.
const ICONOS: Record<RedId, string> = {
  instagram:
    '<path d="M4 8.5A1.5 1.5 0 0 1 5.5 7H8l1.2-2h5.6L16 7h2.5A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z"/><circle cx="12" cy="13" r="3.5"/>',
  whatsapp:
    '<path d="M5 5h14a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 19 17h-7l-4.5 3.5V17H5a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 5 5z"/><path d="M8 9.5h8M8 12.5h5"/>',
  linkedin:
    '<rect x="3.5" y="7.5" width="17" height="12" rx="2"/><path d="M9 7.5V6a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 6v1.5M3.5 13h17"/>',
};

const comunidad = String(d.datos.comunidad ?? '');
const [marcaComunidad, ...restoComunidad] = comunidad.split(' · ');
---

<div class="cierre">
  <div class="cierre__foto" aria-hidden="true">
    <Image src={charla} alt="" width={1000} height={1000} widths={[640, 1000]} sizes="(max-width: 820px) 100vw, 64vw" loading="lazy" decoding="async" />
  </div>

  <header class="cabeza cierre__cabeza">
    {d.etiqueta && <p class="etiqueta ent" style="--i:0">{d.etiqueta}</p>}
    <h3 class="titulo ent" style="--i:1">{d.titulo}</h3>
  </header>

  <div class="cierre__qr ent" style="--i:3">
    <div class="qr-placa" set:html={qr} />
    <a class="accion accion--enlace qr__url" href={urlSitio}>
      <span>{textoUrl}</span>
      <span aria-hidden="true">→</span>
    </a>
    <CopiarBoton valor={urlSitio} etiqueta="Copiar enlace" nombre="el enlace de la presentación" />
  </div>

  <div class="cierre__info">
    <div class="cierre__leyenda ent" style="--i:4" set:html={d.html} />

    <section class="cierre__contacto ent" style="--i:5" aria-label={String(d.datos.contacto ?? 'Contacto')}>
      <p class="cierre__rotulo">
        <span>{d.datos.contacto ?? 'Contacto'}</span>
        {contacto.nombre && <strong class="cierre__nombre">{contacto.nombre}</strong>}
      </p>
      <ul class="contacto">
        {
          REDES.map((red) => {
            const dato = contacto.redes[red];
            return (
              <li>
                {dato ? (
                  <a class="accion accion--secundaria contacto__accion" href={dato.url} target="_blank" rel="noopener noreferrer" aria-label={`${NOMBRES[red]}: ${dato.texto} (se abre en una pestaña nueva)`} data-contacto={red}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONOS[red]} />
                    <span class="contacto__texto">
                      <span class="contacto__red">{NOMBRES[red]}</span>
                      <span class="contacto__valor">{dato.texto}</span>
                    </span>
                  </a>
                ) : (
                  <span class="contacto__falta" data-contacto={red} data-falta>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONOS[red]} />
                    <span class="contacto__texto">
                      <span class="contacto__red">{NOMBRES[red]}</span>
                      <span class="contacto__valor">por completar</span>
                    </span>
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>

    <div class="cierre__comunidad ent" style="--i:6">
      <img class="logo logo--oscuro" src="/media/gdg-logo-oscuro.svg" width="1920" height="390" alt="Google Developer Group Santa Cruz" />
      <img class="logo logo--claro" src="/media/gdg-logo-claro.svg" width="1920" height="390" alt="Google Developer Group Santa Cruz" />
      {
        comunidad && (
          <p class="cierre__comunidad-texto">
            <strong>{marcaComunidad}</strong>
            {restoComunidad.length > 0 && <span> · {restoComunidad.join(' · ')}</span>}
          </p>
        )
      }
    </div>
  </div>
</div>
