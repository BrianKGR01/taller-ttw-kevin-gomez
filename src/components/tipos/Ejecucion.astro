---
import Video from '../Video.astro';
import type { ItemDiapo } from '../../lib/deck';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d } = Astro.props;
---

<Video nombre="agentes2" clase="ejecucion__video" />
<div class="ejecucion">
  <header class="cabeza">
    {d.etiqueta && <p class="etiqueta ent" style="--i:0">{d.etiqueta}</p>}
    <h3 class="titulo ent" style="--i:1">{d.titulo}</h3>
  </header>
  <div class="lista__items ejecucion__items" set:html={d.html} />
</div>
