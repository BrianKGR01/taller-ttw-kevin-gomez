---
import { Image } from 'astro:assets';
import type { ItemDiapo } from '../../lib/deck';
import uml from '../../assets/libros/uml.webp';
import proceso from '../../assets/libros/proceso-unificado.webp';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d } = Astro.props;
---

<div class="libros">
  <header class="cabeza">
    {d.etiqueta && <p class="etiqueta ent" style="--i:0">{d.etiqueta}</p>}
    <h3 class="titulo ent" style="--i:1">{d.titulo}</h3>
  </header>
  <div class="libros__rejilla">
    <ul class="libros__tapas" aria-label="Libros">
      <li class="libro ent" style="--i:2">
        <div class="libro__tapa">
          <Image src={uml} alt="Tapa de El Lenguaje Unificado de Modelado, guía del usuario, de Booch, Rumbaugh y Jacobson" width={297} height={400} widths={[200, 297, 400]} sizes="(max-width: 820px) 40vw, 20vw" />
        </div>
        <p class="libro__pie"><strong>El Lenguaje Unificado de Modelado (UML 2.0). Guía del usuario</strong><span>Booch, Rumbaugh y Jacobson</span></p>
      </li>
      <li class="libro ent" style="--i:3">
        <div class="libro__tapa">
          <Image src={proceso} alt="Tapa de El Proceso Unificado de Desarrollo de Software, de Jacobson, Booch y Rumbaugh" width={310} height={400} widths={[200, 310, 400]} sizes="(max-width: 820px) 40vw, 20vw" />
        </div>
        <p class="libro__pie"><strong>El Proceso Unificado de Desarrollo de Software</strong><span>Jacobson, Booch y Rumbaugh</span></p>
      </li>
    </ul>
    <div class="libros__texto ent" style="--i:4" set:html={d.html} />
  </div>
</div>
