---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import CopiarBoton from '../CopiarBoton.astro';
import Descarga from '../Descarga.astro';
import type { ItemDiapo } from '../../lib/deck';

interface Props {
  d: ItemDiapo;
  etiquetaBloque: string;
}
const { d } = Astro.props;
// `datos.copiar` / `datos.descarga`: archivo completo para copiar o bajar (por ejemplo la plantilla AGENTS.md).
const textoCompleto: string | undefined = d.datos.copiar ? readFileSync(join(process.cwd(), d.datos.copiar), 'utf8') : undefined;
---

<div class="prompt">
  <header class="cabeza">
    {d.etiqueta && <p class="etiqueta ent" style="--i:0">{d.etiqueta}</p>}
    <h3 class="titulo ent" style="--i:1">{d.titulo}</h3>
    {d.subtitulo && <p class="subtitulo ent" style="--i:2">{d.subtitulo}</p>}
  </header>
  <div class="prompt__codigo ent" style="--i:3" set:html={d.html} />
  {(textoCompleto || d.datos.descarga) && (
    <div class="prompt__acciones ent" style="--i:4">
      {textoCompleto && <CopiarBoton valor={textoCompleto} etiqueta="Copiar la plantilla completa" nombre="la plantilla completa" />}
      {d.datos.descarga && <Descarga archivo={d.datos.descarga} etiqueta={`Descargar ${d.datos.descarga}`} />}
    </div>
  )}
</div>
